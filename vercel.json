{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "content/**,locales/**,public/ai-catalog.json,public/404.html"
    }
  },
  "rewrites": [
    { "source": "/(svg-to-webp|png-to-webp|jpg-to-webp|webp-to-png|svg-to-png|png-to-avif|avif-to-webp|reports)", "destination": "/api/index.js?__zap_url=/$1" },
    { "source": "/api", "destination": "/api/index.js?__zap_url=/api" },
    { "source": "/api/(.*)", "destination": "/api/index.js?__zap_url=/api/$1" },
    { "source": "/health", "destination": "/api/index.js?__zap_url=/health" },
    { "source": "/mcp", "destination": "/api/index.js?__zap_url=/mcp" },
    { "source": "/feed.xml", "destination": "/api/index.js?__zap_url=/feed.xml" },
    { "source": "/docs", "destination": "/api/index.js?__zap_url=/docs" },
    { "source": "/docs/(.*)", "destination": "/api/index.js?__zap_url=/docs/$1" },
    { "source": "/(convert|cli|clean|formats|safety|errors|developers|about|privacy|terms|security|code-of-conduct|contributing|translators|lock-target|backgrounds|policy|smart|smart-optimization|lossless|lossless-mode|carbon|performance-reports|ai-integration|ai-pipeline|scaffolding|faq|stability|performance|reliability|reliability-masterplan|freeze|ui)", "destination": "/api/index.js?__zap_url=/$1" },
    { "source": "/(plugins|storage|sdk)/(.*)", "destination": "/api/index.js?__zap_url=/$1/$2" },
    { "source": "/(.*\\.md)", "destination": "/api/index.js?__zap_url=/$1" },
    { "source": "/plugins/(.*\\.md)", "destination": "/api/index.js?__zap_url=/plugins/$1" },
    { "source": "/sdk/(.*\\.md)", "destination": "/api/index.js?__zap_url=/sdk/$1" }
  ],
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/ai-catalog.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/schemas/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
