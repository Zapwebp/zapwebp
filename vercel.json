{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/server.js?__zap_url=/api" },
    { "source": "/api/(.*)", "destination": "/server.js?__zap_url=/api/$1" },
    { "source": "/health", "destination": "/server.js?__zap_url=/health" },
    { "source": "/feed.xml", "destination": "/server.js?__zap_url=/feed.xml" },
    { "source": "/(.*\\.md)", "destination": "/server.js?__zap_url=/$1" },
    { "source": "/plugins/(.*\\.md)", "destination": "/server.js?__zap_url=/plugins/$1" },
    { "source": "/sdk/(.*\\.md)", "destination": "/server.js?__zap_url=/sdk/$1" }
  ],
  "headers": [
    {
      "source": "/schemas/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
