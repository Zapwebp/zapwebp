{
  "name": "@zapwebp/plugin-sdk",
  "version": "1.1.1",
  "description": "Plugin SDK for extending Zap conversion workflows, adapters, and pipelines.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./next": {
      "types": "./src/next.d.ts",
      "default": "./src/next.js"
    },
    "./action": {
      "types": "./src/action.d.ts",
      "default": "./src/action.js"
    },
    "./storage": {
      "types": "./src/storage.d.ts",
      "default": "./src/storage.js"
    }
  },
  "dependencies": {
    "@zapwebp/storage": "workspace:*"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://zapwebp.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zapwebp/plugin-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Zapwebp/plugin-sdk/issues"
  },
  "author": "Eldrex Delos Reyes Bula <eldrexdelosreyesbula@gmail.com>"
}
