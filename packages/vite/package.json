{
  "name": "zapwebp-vite",
  "version": "1.0.0",
  "description": "Official first-party Vite plugin for Zapwebp - zero-config image and vector asset conversion with transparency safety, retina multipliers, and modern picture markup.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "zapwebp",
    "webp",
    "svg",
    "image-optimization",
    "transparency"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@zapwebp/core": "workspace:*",
    "@zapwebp/shared": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://zapwebp.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zapwebp/vite.git"
  },
  "bugs": {
    "url": "https://github.com/Zapwebp/vite/issues"
  },
  "author": "Eldrex Delos Reyes Bula <eldrexdelosreyesbula@gmail.com>"
}
