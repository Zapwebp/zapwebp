{
  "$schema": "https://zapwebp-docs.vercel.app/schemas/agent-manifest.json",
  "name": "@zapwebp/storage",
  "version": "1.1.0",
  "type": "sdk",
  "description": "First-party cloud adapters for Supabase, Firebase, and Neocities with pre-upload conversion and cascading deletion.",
  "install": "npm install @zapwebp/storage",
  "homepage": "https://zapwebp.vercel.app",
  "docs": "https://zapwebp-docs.vercel.app/sdk/storage",
  "docsMarkdown": "https://zapwebp.vercel.app/sdk/storage.md",
  "repository": "https://github.com/Zapwebp/storage",
  "contact": "eldrexdelosreyesbula@gmail.com",
  "adapters": [
    "SupabaseStorageAdapter",
    "FirebaseStorageAdapter",
    "NeocitiesStorageAdapter"
  ],
  "capabilities": [
    "pre-upload-conversion",
    "cascading-variant-deletion",
    "atomic-manifest-updates"
  ]
}
