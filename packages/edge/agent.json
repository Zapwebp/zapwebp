  "install": "npm install @zapwebp/edge",
  "homepage": "https://zapwebp.vercel.app",
  "docs": "https://zapwebp-docs.vercel.app/sdk/edge",
  "docsMarkdown": "https://zapwebp.vercel.app/sdk/edge.md",
  "repository": "https://github.com/Zapwebp/edge",
  "contact": "eldrexdelosreyesbula@gmail.com",
  "exports": [
    "handleEdgeRequest",
    "createEdgeHandler",
    "verifyEdgePayload"
  ],
  "compatibility": [
    "cloudflare-workers",
    "vercel-edge-functions",
    "fastly-compute",
    "deno",
    "bun"
